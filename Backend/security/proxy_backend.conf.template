# Never trust client-supplied forwarding headers for source-based limits.
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Connection "";
proxy_set_header X-Control-Token "";
proxy_http_version 1.1;
proxy_connect_timeout 5s;
proxy_read_timeout 10s;
# Resolve Docker service names again after a container is recreated.
resolver 127.0.0.11 valid=5s ipv6=off;
set $workshop_upstream "${BACKEND}";
proxy_pass $workshop_upstream;
